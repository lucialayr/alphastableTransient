# Exclude large generated data files from Docker build context
data/*.csv
data/final_states_*.csv
data/trajectories_*.csv

# Exclude figures (generated by analysis)
figures/*

# Exclude git files
.git/
.gitignore
.gitattributes

# Exclude Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Exclude R files
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Exclude Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Exclude macOS
.DS_Store

# Exclude conda/environment files not needed in image
conda-lock.yml
.conda/

# Exclude documentation for Docker itself
Dockerfile
.dockerignore
docker-compose.yml

# Exclude IDE files
.vscode/
.idea/
